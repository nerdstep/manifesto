{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node"],

  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "warn"
  },

  "env": {
    "builtin": true,
    "es2024": true,
    "node": true
  },

  "rules": {
    "curly": ["error", "all"],

    // ON, deliberately. `!` asserts something the compiler cannot check, which
    // is the exact thing `noUncheckedIndexedAccess` exists to prevent — using
    // one to silence the other cancels out the setting.
    //
    // For indexed reads into pixel buffers, write `buf[i] ?? 0`. The fallback is
    // unreachable when the index is in range by construction, but it is CHECKED
    // rather than asserted, and for an alpha probe `?? 0` also happens to mean
    // exactly the right thing: no pixel is not painted.
    "typescript/no-non-null-assertion": "error",

    // Stage modules carry unused params until their phase lands.
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "typescript/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],

    // `null` is meaningful here: a Dark Mark is absent (null), not merely
    // unset, and `background: null` means "transparent" in the Treatment table.
    "unicorn/no-null": "off",

    // An Asset Bundle that comes out empty because an error was swallowed is
    // the exact failure this app must never have.
    "no-empty": ["error", { "allowEmptyCatch": false }],

    "no-console": "off",

    // --- pedantic rules switched off, with reasons -----------------------
    // `TODO(phase-N)` markers are how PLAN.md's phasing is expressed in code.
    // Flagging them fights the plan.
    "no-warning-comments": "off",

    // EmptyMarkError and InvalidSvgError are two spellings of "this mark can't
    // become an icon". Splitting them across files would hide that.
    "max-classes-per-file": "off",

    // `describe()` blocks are functions, so this rule reads every test suite as
    // one oversized function. Meaningless here.
    "max-lines-per-function": "off",

    // Sequential awaits are correct when the work is ordered or when the
    // underlying call is synchronous anyway, which is true of rasterization.
    "no-await-in-loop": "off",

    // Both fight readable code rather than protect anything.
    "no-inline-comments": "off",
    "sort-vars": "off",

    // Guards against `var`'s function scoping, which TypeScript + this config make
    // unreachable. Every hit here is a `const` in a `for…of` closed over safely, so
    // the rule has no true positives available in this codebase.
    "no-loop-func": "off",

    "no-plusplus": "error",

    "unicorn/no-array-reduce": "error",

    // `getElementById` is the precise tool for an id and is what the one DOM lookup
    // helper uses. Preferring `querySelector` everywhere would trade precision for
    // uniformity.
    "unicorn/prefer-query-selector": "off",

    // --- type-aware -------------------------------------------------------
    // Wants `readonly` on every array/object parameter, including `Uint8Array`
    // pixel buffers where it isn't expressible. typescript-eslint ships this
    // rule off by default for the same reason.
    "typescript/prefer-readonly-parameter-types": "off"
  },

  "overrides": [
    {
      // `src/webview/**`, not `src/webview/**/*.ts` — the previous glob silently excluded
      // every `.tsx` file, which is all of the components.
      "files": ["src/webview/**"],
      "rules": {
        // Electrobun serves the view bundle with a plain `<script src>`, so it is a
        // classic script, not a module. Top-level await is a SYNTAX ERROR there — and a
        // syntax error takes the drop guards down with it, which presents as "drag and
        // drop doesn't work". Following this rule here actively broke the app once.
        "unicorn/prefer-top-level-await": "off",

        // The guard that keeps host code out of the browser bundle.
        //
        // A value import from the pipeline once pulled `svgo`, `ico-endec` and
        // `node:crypto` into the view: 1.88 MB that failed to load, taking the drop
        // handlers with it. The symptom was "drag and drop doesn't work", which is two
        // steps from the cause and reads exactly like a framework limitation.
        //
        // `allowTypeImports` is what makes this expressible: the webview names pipeline
        // types constantly (`Settings`, `Advisory`, `Hex`) and those erase at compile
        // time. Verified — with it off, 5 legitimate type imports are flagged; with it
        // on, none, while a real value import still is.
        //
        // This is per-file, but it enforces the transitive property, because
        // `src/shared/**` below is closed under the same restriction. Anything the
        // webview can reach is itself unable to reach the host.
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/pipeline/**", "**/bun/**", "**/cli/**", "**/host/**"],
                "allowTypeImports": true,
                "message": "The webview may only import values from src/webview, src/shared, and preact. Host code in the view bundle fails to load at runtime — move the value into src/shared, or import it as `import type`."
              },
              {
                "group": ["node:*"],
                "message": "Node builtins cannot resolve in a webview."
              }
            ]
          }
        ]
      }
    },
    {
      // `src/shared/` is the code the webview and the host both use, so it has to obey the
      // webview's restrictions or it becomes the hole in them. This override is what makes
      // the per-file rule above add up to a transitive guarantee.
      //
      // Host-side shared code lives in `src/host/` instead — see `src/host/failures.ts`,
      // which needs the error classes as values and therefore cannot live here.
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/pipeline/**",
                  "**/bun/**",
                  "**/cli/**",
                  "**/host/**",
                  "**/webview/**"
                ],
                "allowTypeImports": true,
                "message": "src/shared must stay importable by the webview, so it may not import values from the host or the pipeline. Put host-only code in src/host instead."
              },
              {
                "group": ["node:*"],
                "message": "src/shared is imported by the webview, where Node builtins cannot resolve."
              }
            ]
          }
        ]
      }
    }
  ],

  // `docs/reference/` is not linted. It holds preserved Phase 0 spike code whose
  // value is being *the code that produced the measurements* in
  // docs/phase-0-findings.md — rewriting it to production standards would
  // destroy that. It stays inside tsconfig's `include`, so it must still
  // compile: "still valid" is enforced, "maintained to standard" is not.
  "ignorePatterns": ["build/**", "node_modules/**", "test/fixtures/**", "docs/reference/**"]
}
